# house-eyes tracker settings. Copied to /etc/house-eyes/tracker.ini on first
# install; edit that copy, then:  sudo systemctl restart house-eyes-tracker
# Anything left out uses the default shown here.

[camera]
# picamera2             Pi Camera Module on the ribbon connector
# usb:0                 USB webcam (/dev/video0)
# rtsp://user:pw@ip/... network camera
# file:/path/video.mp4  recorded video, looped (for testing)
source = picamera2
width = 1280
height = 720
# 0, 90, 180 or 270, and/or mirror, if the camera is mounted that way
rotate = 0
hflip = no

[detector]
# myriad: person detector on the Neural Compute Stick 2
# motion: anything that moves, on the CPU (fallback if the stick is missing)
type = myriad
model = /opt/house-eyes/models/person-detection-retail-0013.xml
# 0-1; raise if it sees people that aren't there, lower if it misses people
confidence = 0.55
# ignore detections shorter than this fraction of the picture height
min_height = 0.08
requests = 2

[tracking]
# seconds a person can go unseen (e.g. hidden behind someone) before
# they're forgotten
lost_after = 1.0
# detections needed before a new person counts (filters one-off false alarms)
confirm_hits = 2
# 0-1: how much each new detection moves a person's box (lower = calmer)
smooth = 0.5
# seconds to look ahead of a walking person (hides camera/detector lag)
lead = 0.15

[attention]
# yes: with 2 or more people, each eye picks its own person (left to right).
# no: all three eyes always watch the same person.
split = yes
# seconds an eye stays with someone before it may move to someone more
# interesting (picked at random between these)
dwell_min = 3.0
dwell_max = 7.0
# what's interesting: new arrivals, and people who stop to look
newcomer_bonus = 1.0
still_bonus = 0.8
# crowd mode: at crowd_enter people or more, each eye darts between random
# people with wide pupils; back to normal at crowd_exit or fewer
crowd_enter = 7
crowd_exit = 5
glance_min = 0.5
glance_max = 1.5
crowd_pupil = 0.95
# pupils widen when someone gets close (taller than this fraction of the
# picture); 0 turns this off
close_height = 0.45
close_pupil = 0.85

[calibration]
# Where in the camera picture (0 = left edge, 1 = right edge) the eyes
# should look fully left / fully right on the projected screen. Stand at
# each end of the sidewalk and read x off the preview page.
x_left = 0.0
x_right = 1.0
# yes if the eyes look the opposite way to the person
flip_x = no
# Gaze height (-1 down .. 1 up) when the person's feet are at the top /
# bottom of the picture.
y_at_top = -0.1
y_at_bottom = -0.7
# Only track people whose feet are inside this box (fractions: x0,y0,x1,y1).
roi = 0,0,1,1

[output]
# where tri-eyes.py listens for gaze messages
host = 127.0.0.1
port = 5005
rate = 15

[preview]
# browser view for calibration: http://eyes.local:8080/  (0 = off)
port = 8080
fps = 5
